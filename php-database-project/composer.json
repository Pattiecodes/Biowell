{
  "name": "pattiecodes/biowell",
  "description": "BioWell insurance PHP application",
  "type": "project",
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-pdo": "*",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "vercel": [
      "composer install --no-dev --optimize-autoloader"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}